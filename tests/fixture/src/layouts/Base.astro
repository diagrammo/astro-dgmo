---
// Global layout wrapper. Responsibilities:
//
//   1. Import `remark-dgmo/client.css`. Astro 6's IntegrationHook has
//      no programmatic stylesheet injection, so this is the documented
//      manual step from the astro-dgmo README — without it, light/dark
//      diagram wrappers both render at the same time.
//   2. Import `remark-dgmo/theme-nord.css` — the shared Nord page theme so
//      the chrome matches dgmo's default `nord` diagram palette. It drives
//      `body` background/foreground via `--dgmo-*` vars (light + dark).
//   3. Provide a `data-theme` toggle on `<html>` so the color-mode swap
//      can be eyeballed against `[data-theme="dark"]`-keyed CSS.
//   4. Build a table-of-contents sidebar from `Astro.props.headings`
//      (supplied automatically when this layout wraps a markdown page):
//      h2 headings become group labels, h3 headings become indented
//      sub-links. Purely derived — nothing hardcoded. When there are no
//      headings (non-markdown usage), no sidebar renders.
import 'remark-dgmo/client.css';
import 'remark-dgmo/theme-nord.css';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title?: string;
  headings?: Heading[];
}
const { title = 'Diagrammo × Astro', headings = [] } = Astro.props;

interface TocGroup {
  slug: string;
  text: string;
  children: Heading[];
}
const tocGroups: TocGroup[] = [];
for (const h of headings) {
  if (h.depth === 2) {
    tocGroups.push({ slug: h.slug, text: h.text, children: [] });
  } else if (h.depth === 3 && tocGroups.length > 0) {
    tocGroups[tocGroups.length - 1].children.push(h);
  }
}
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="alternate icon" href={`${import.meta.env.BASE_URL}favicon.ico`} sizes="any" />
    <title>{title}</title>
    <style is:global>
      :root { color-scheme: light; }
      :root[data-theme='dark'] { color-scheme: dark; }
      /* Layout only — colors come from remark-dgmo/theme-nord.css (--dgmo-*). */
      body {
        font-family: system-ui, sans-serif;
        max-width: 920px;
        margin: 0 auto;
        /* Top padding reserves room for the fixed brand banner. */
        padding: calc(2rem + 48px) 1.5rem 4rem;
      }
      button.theme-toggle {
        position: fixed;
        top: calc(48px + 0.6rem);
        right: 1rem;
        padding: 0.4rem 0.8rem;
        cursor: pointer;
        background: var(--dgmo-surface);
        color: var(--dgmo-fg);
        border: 1px solid var(--dgmo-border);
        border-radius: 0.4rem;
      }
      /* Table-of-contents sidebar — hidden on narrow viewports so the
         single-column look is unchanged below 1100px. Plain anchors,
         no scroll-spy. Colors ride the same --dgmo-* vars as the rest
         of the page, so light/dark both work. */
      nav.toc {
        display: none;
      }
      @media (min-width: 1100px) {
        nav.toc {
          display: block;
          position: fixed;
          top: 48px;
          left: 0;
          width: 240px;
          max-height: calc(100vh - 48px);
          overflow-y: auto;
          padding: 2rem 1rem 2rem 1.25rem;
          box-sizing: border-box;
          border-right: 1px solid var(--dgmo-border);
          font-size: 0.85rem;
          line-height: 1.4;
        }
        /* Content keeps its max-width but shifts right of the sidebar. */
        body:has(nav.toc) {
          margin-left: 280px;
          margin-right: auto;
        }
      }
      nav.toc ul {
        list-style: none;
        margin: 0;
        padding: 0;
      }
      nav.toc > ul > li + li {
        margin-top: 0.9rem;
      }
      nav.toc a {
        display: block;
        padding: 0.1rem 0;
        color: var(--dgmo-muted);
        text-decoration: none;
      }
      nav.toc a:hover {
        color: var(--dgmo-accent-hover);
        text-decoration: underline;
      }
      nav.toc a.toc-group {
        color: var(--dgmo-fg);
        font-weight: 600;
      }
      nav.toc a.toc-item {
        padding-left: 0.9rem;
      }
      /* Diagrammo showcase banner — brand top-bar, kept identical across every
         wrapper's Pages showcase so they read as one family. Full-bleed, so it
         escapes the centered `body` max-width via negative margins. */
      a.dgmo-embed-banner {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        box-sizing: border-box;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: 48px;
        padding: 0 clamp(0.75rem, 3vw, 1.25rem);
        background: linear-gradient(90deg, #27333f 0%, #1c242e 100%);
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow: inset 0 2px 0 #3a9188;
        color: #e6edf3;
        font: 500 0.875rem/1.3 system-ui, -apple-system, 'Segoe UI', sans-serif;
        text-decoration: none;
        z-index: 100;
      }
      a.dgmo-embed-banner:hover .dgmo-embed-banner__cta {
        background: rgba(255, 255, 255, 0.2);
        border-color: rgba(255, 255, 255, 0.3);
      }
      .dgmo-embed-banner__brand {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        flex-shrink: 0;
      }
      .dgmo-embed-banner__brand svg {
        width: 26px;
        height: 26px;
        display: block;
      }
      .dgmo-embed-banner__word {
        font-weight: 700;
        font-size: 1rem;
        letter-spacing: -0.01em;
        color: #fff;
      }
      .dgmo-embed-banner__msg {
        color: #aeb9c4;
        flex: 1 1 auto;
        min-width: 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .dgmo-embed-banner__cta {
        flex-shrink: 0;
        margin-left: auto;
        white-space: nowrap;
        font-weight: 600;
        color: #fff;
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.16);
        padding: 0.32rem 0.8rem;
        border-radius: 999px;
        transition:
          background 0.15s,
          border-color 0.15s;
      }
      @media (max-width: 720px) {
        .dgmo-embed-banner__msg {
          display: none;
        }
      }
      @media (max-width: 460px) {
        .dgmo-embed-banner__cta-long {
          display: none;
        }
      }
    </style>
  </head>
  <body>
    <a
      class="dgmo-embed-banner"
      href="https://diagrammo.app"
      aria-label="Diagrammo — go to diagrammo.app"
    >
      <span class="dgmo-embed-banner__brand">
        <svg viewBox="0 0 100 100" aria-hidden="true">
          <rect x="11" y="8" width="22" height="39.5" rx="2.5" fill="#c0504d" />
          <rect x="11" y="52.5" width="22" height="22.1" rx="2.5" fill="#5b9357" />
          <rect x="11" y="79.6" width="22" height="12.4" rx="2.5" fill="#4f96c4" />
          <path fill="#3a9188" d="M45 11.12 A3 3 0 0 1 48.23 8.12 A42 42 0 0 1 86.52 43.65 A3 3 0 0 1 83.78 47.10 L72.76 47.92 A3 3 0 0 1 69.59 45.47 A25 25 0 0 0 47.68 25.14 A3 3 0 0 1 45 22.16 Z" />
          <path fill="#7d5ba6" d="M83.78 52.90 A3 3 0 0 1 86.52 56.35 A42 42 0 0 1 74.53 79.87 A3 3 0 0 1 70.13 79.67 L62.99 71.24 A3 3 0 0 1 63.12 67.23 A25 25 0 0 0 69.59 54.53 A3 3 0 0 1 72.76 52.08 Z" />
          <path fill="#cc7a33" d="M65.43 83.08 A3 3 0 0 1 64.27 87.32 A42 42 0 0 1 48.23 91.88 A3 3 0 0 1 45 88.88 L45 77.84 A3 3 0 0 1 47.68 74.86 A25 25 0 0 0 55.78 72.56 A3 3 0 0 1 59.63 73.69 Z" />
        </svg>
        <span class="dgmo-embed-banner__word">Diagrammo</span>
      </span>
      <span class="dgmo-embed-banner__msg">
        Turn plain text into diagrams — a live showcase of every chart type.
      </span>
      <span class="dgmo-embed-banner__cta">
        Get started<span class="dgmo-embed-banner__cta-long">
          at diagrammo.app</span
        > →
      </span>
    </a>
    <button class="theme-toggle" type="button" id="theme-toggle">
      Toggle dark mode
    </button>
    {
      tocGroups.length > 0 && (
        <nav class="toc" aria-label="Table of contents">
          <ul>
            {tocGroups.map((group) => (
              <li>
                <a class="toc-group" href={`#${group.slug}`}>
                  {group.text}
                </a>
                {group.children.length > 0 && (
                  <ul>
                    {group.children.map((child) => (
                      <li>
                        <a class="toc-item" href={`#${child.slug}`}>
                          {child.text}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </nav>
      )
    }
    <slot />
    <script is:inline>
      const btn = document.getElementById('theme-toggle');
      btn?.addEventListener('click', () => {
        const root = document.documentElement;
        const next =
          root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
      });
    </script>
  </body>
</html>
